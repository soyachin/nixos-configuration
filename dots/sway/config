# ================================================================
# sway/config — migrado desde hyprland.conf
# ================================================================

################
## MONITORES  ##
################
output eDP-1 {
    mode   1920x1080@144Hz
    pos    0 0
    scale  1
}
output HDMI-A-1 {
    mode   1920x1080@60Hz
    pos    1920 0
    scale  1
}

################
## AUTOSTART  ##
################
exec swaybg --image /home/hojas/Pictures/Waterhouse_Echo_and_Narcissus_wall.jpg
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway GTK_THEME=Gruvbox-Dark
exec noctalia-shell > /tmp/noctalia.log 2>&1

################
## ENTORNO    ##
################
seat seat0 xcursor_theme macOS 24

################
## INPUT      ##
################
input type:keyboard {
    xkb_layout  latam
    xkb_numlock enabled
}

input type:touchpad {
    tap             enabled
    dwt             enabled
    natural_scroll  disabled
}

input type:pointer {
    accel_profile flat
    pointer_accel 0
}

################
## GENERAL    ##
################
gaps inner 1
gaps outer 3

default_border         pixel 2
default_floating_border pixel 2

################
## COLORES    ##
################
client.focused          #98971a #98971a #ebdbb2 #98971a #98971a
client.unfocused        #3C3C51 #3C3C51 #a89984 #3C3C51 #3C3C51
client.focused_inactive #3C3C51 #3C3C51 #a89984 #3C3C51 #3C3C51

################
## MISC       ##
################
focus_on_window_activation focus

################
## VARIABLES  ##
################
set $mod   Mod4
set $left  h
set $down  j
set $up    k
set $right l

################
## KEYBINDS   ##
################

# ── Apps ────────────────────────────────────────────────────────
bindsym $mod+t        exec kitty
bindsym $mod+d        exec rofi -show drun
bindsym $mod+Alt+l    exec swaylock
bindsym $mod+Alt+f    exec auto-f-skip
bindsym $mod+space    exec tmux-session-picker
bindsym Alt+Tab       exec rofi -show window

# ── Noctalia ────────────────────────────────────────────────────
bindsym $mod+Alt+comma exec noctalia-shell ipc call settings toggle
bindsym $mod+p         exec noctalia-shell ipc call bar toggle
bindsym $mod+Shift+r   exec killall noctalia-shell; noctalia-shell > /tmp/noctalia.log 2>&1

# ── Power menu ──────────────────────────────────────────────────
bindsym $mod+s exec \
  echo -e '󰍃 Logout\n󰜉 Reboot\n󰐥 Shutdown' \
  | rofi -dmenu -p 'Power' \
    -theme-str 'window {width: 10em; height: 15%;} listview {lines: 3;} inputbar { enabled: false; }' \
  | xargs -I{} sh -c \
    'case "{}" in *Logout*) swaymsg exit ;; *Reboot*) systemctl reboot ;; *Shutdown*) systemctl poweroff ;; esac'

# ── Audio ───────────────────────────────────────────────────────
bindsym --locked XF86AudioRaiseVolume exec noctalia-shell ipc call volume increase
bindsym --locked XF86AudioLowerVolume exec noctalia-shell ipc call volume decrease
bindsym --locked XF86AudioMute        exec noctalia-shell ipc call volume muteOutput
bindsym --locked XF86AudioMicMute     exec noctalia-shell ipc call volume muteInput

# ── Brillo ──────────────────────────────────────────────────────
bindsym --locked XF86MonBrightnessUp   exec noctalia-shell ipc call brightness increase
bindsym --locked XF86MonBrightnessDown exec noctalia-shell ipc call brightness decrease

# ── Ventanas ────────────────────────────────────────────────────
bindsym $mod+q       kill
bindsym $mod+v       floating toggle
bindsym $mod+f       fullscreen toggle
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+c       move position center
bindsym $mod+Shift+p exec swaymsg output '*' power off

# ── Foco ────────────────────────────────────────────────────────
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

# ── Mover ventanas ──────────────────────────────────────────────
bindsym $mod+Ctrl+$left  move left
bindsym $mod+Ctrl+$down  move down
bindsym $mod+Ctrl+$up    move up
bindsym $mod+Ctrl+$right move right
bindsym $mod+Ctrl+Left   move left
bindsym $mod+Ctrl+Down   move down
bindsym $mod+Ctrl+Up     move up
bindsym $mod+Ctrl+Right  move right

# ── Foco entre monitores ────────────────────────────────────────
bindsym $mod+comma  focus output left
bindsym $mod+period focus output right

# ── Mover ventana al otro monitor ───────────────────────────────
bindsym $mod+Shift+comma  move container to output left;  focus output left
bindsym $mod+Shift+period move container to output right; focus output right

# ── Workspaces ──────────────────────────────────────────────────
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Ctrl+1 move container to workspace number 1
bindsym $mod+Ctrl+2 move container to workspace number 2
bindsym $mod+Ctrl+3 move container to workspace number 3
bindsym $mod+Ctrl+4 move container to workspace number 4
bindsym $mod+Ctrl+5 move container to workspace number 5
bindsym $mod+Ctrl+6 move container to workspace number 6
bindsym $mod+Ctrl+7 move container to workspace number 7
bindsym $mod+Ctrl+8 move container to workspace number 8
bindsym $mod+Ctrl+9 move container to workspace number 9

# ── Navegación relativa de workspaces ───────────────────────────
bindsym $mod+Page_Down workspace next
bindsym $mod+Page_Up   workspace prev
bindsym $mod+i         workspace next
bindsym $mod+u         workspace prev

bindsym $mod+Ctrl+Page_Down move container to workspace next
bindsym $mod+Ctrl+Page_Up   move container to workspace prev
bindsym $mod+Ctrl+i         move container to workspace next
bindsym $mod+Ctrl+u         move container to workspace prev

# Scroll con rueda del mouse
bindsym $mod+button5 workspace next
bindsym $mod+button4 workspace prev

# ── Resize ──────────────────────────────────────────────────────
mode "resize" {
    bindsym $left  resize shrink width  20px
    bindsym $right resize grow   width  20px
    bindsym $up    resize shrink height 20px
    bindsym $down  resize grow   height 20px
    bindsym Left   resize shrink width  20px
    bindsym Right  resize grow   width  20px
    bindsym Up     resize shrink height 20px
    bindsym Down   resize grow   height 20px

    bindsym KP_Add      resize grow   width  100px
    bindsym KP_Subtract resize shrink width  100px
    bindsym Shift+KP_Add      resize shrink height 100px
    bindsym Shift+KP_Subtract resize grow   height 100px

    bindsym Escape mode "default"
    bindsym Return mode "default"
}
bindsym $mod+r mode "resize"

# ── Layouts ─────────────────────────────────────────────────────
bindsym $mod+w       layout toggle tabbed splith splitv
bindsym $mod+Tab     focus next sibling
bindsym $mod+Shift+Tab focus prev sibling

# ── Screenshots ──────────────────────────────────────────────────
bindsym Print       exec grimshot copy area
bindsym Ctrl+Print  exec grimshot copy screen
bindsym Alt+Print   exec grimshot copy active

# ── Sesión ───────────────────────────────────────────────────────
bindsym $mod+Shift+e  exit
bindsym Ctrl+Alt+Delete exit
